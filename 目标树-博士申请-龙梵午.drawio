<mxfile host="app.diagrams.net" modified="2026-09-19T09:30:00.000Z" agent="Cursor" version="24.0.0" type="device">
  <diagram id="phd" name="博士申请">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="sys" value="系统：本科结束前的博士申请" style="text;html=1;fontSize=11;fontColor=#3D6284;align=left;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="16" y="6" width="240" height="16" as="geometry" />
        </mxCell>
        <mxCell id="goal" value="交出一份站得住的博士申请" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F1FC;fontColor=#1B4F82;strokeColor=#A9C9EA;strokeWidth=2;fontSize=16;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="340" y="18" width="780" height="48" as="geometry" />
        </mxCell>

        <mxCell id="R1" value="申请里写的是自己的研究线&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#C45650&quot;&gt;问题、做过的一块、下一问，都从自己的项目来&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;fontColor=#B23A34;strokeColor=#F0B4AC;strokeWidth=2;fontSize=13;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="36" y="88" width="460" height="56" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="投的项目和这条线对得上&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#C45650&quot;&gt;能说出为什么投这几个；对不上的不因为排名留下&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;fontColor=#B23A34;strokeColor=#F0B4AC;strokeWidth=2;fontSize=13;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="960" y="108" width="480" height="56" as="geometry" />
        </mxCell>

        <mxCell id="Y1" value="研究陈述从做过的项目里长出来" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6D6;fontColor=#8A6418;strokeColor=#E6C56A;strokeWidth=1.8;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="24" y="180" width="400" height="44" as="geometry" />
        </mxCell>
        <mxCell id="Y2" value="推荐人能说到具体做了什么、卡在哪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6D6;fontColor=#8A6418;strokeColor=#E6C56A;strokeWidth=1.8;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="500" y="198" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="Y3" value="先看清对方在做什么，再决定投不投" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6D6;fontColor=#8A6418;strokeColor=#E6C56A;strokeWidth=1.8;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="980" y="196" width="440" height="44" as="geometry" />
        </mxCell>

        <mxCell id="G1a" value="问题、已做的一块、卡点写清楚" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFF6EC;fontColor=#1B7A56;strokeColor=#7DCFB0;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="16" y="258" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="G1b" value="下一问从卡点来，写进陈述" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFF6EC;fontColor=#1B7A56;strokeColor=#7DCFB0;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="260" y="276" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="G2a" value="跟过的项目，有人看见过" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFF6EC;fontColor=#1B7A56;strokeColor=#7DCFB0;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="500" y="272" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="G2b" value="自己的 project，也有人能说具体" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFF6EC;fontColor=#1B7A56;strokeColor=#7DCFB0;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
